# Phase 1 needs none of this: with no variables set, the planner runs entirely in
# the browser's localStorage.

# ── Phase 2, cloud (Supabase) ───────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose this to the browser: it bypasses row-level security.
# Used by the calendar push webhook, which arrives from Google with no session.
SUPABASE_SERVICE_ROLE_KEY=

# ── Phase 3, calendar (Google) ──────────────────────────────────────────────
# The same OAuth client configured as Supabase's Google provider. Needed on the
# server to exchange the stored refresh token for an access token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where Google should send calendar push notifications. Must be public HTTPS —
# push notifications cannot reach localhost, so the 15-minute poll covers local
# development. Vercel sets this automatically if omitted.
NEXT_PUBLIC_SITE_URL=
